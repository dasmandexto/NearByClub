# ── Bot ────────────────────────────────────────────────────
BOT_TOKEN=your_telegram_bot_token_here

# ── WebApp ─────────────────────────────────────────────────
# Must be HTTPS for Telegram Mini App
WEBAPP_URL=https://yourdomain.com

# ── Database ───────────────────────────────────────────────
DATABASE_URL=postgresql+asyncpg://nearbyclub:password@localhost:5432/nearbyclub

# ── Redis ──────────────────────────────────────────────────
REDIS_URL=redis://localhost:6379

# ── Geo settings ───────────────────────────────────────────
DEFAULT_RADIUS_M=500
MAX_RADIUS_M=1000
LOCATION_TTL_HOURS=2

# ── Rate limiting ──────────────────────────────────────────
# Max broadcast messages per user per hour
RATE_LIMIT_PER_HOUR=5
